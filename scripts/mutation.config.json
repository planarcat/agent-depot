{
  "_说明": "变异门禁配置（scripts/mutate.py 读取）。改这里 = 改判据口径：提交时走门禁留痕，并附得分改前→改后。",
  "_基线口径": "baseline_scores = 本仓自己的存量水平（2026-10-17 首次接入实测）。已登记的文件只拦「比基线差」，未登记的文件才用 break 阈值。提升测试后跑 --ratchet 上调；只升不降。",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "tolerance": 2.0,
  "baseline_scores": {
    "hub/watcher.py": 33.0,
    "hub/lib/mcpverify.py": 100.0,
    "scripts/lint_baseline.py": 67.65
  },
  "concurrency": 4,
  "report": "reports/mutation.json",
  "targets": [
    {
      "file": "hub/watcher.py",
      "tests": [
        "python3 tests/test_watcher.py"
      ]
    },
    {
      "file": "hub/lib/mcpverify.py",
      "tests": [
        "python3 tests/test_mcp.py"
      ]
    },
    {
      "file": "scripts/lint_baseline.py",
      "tests": [
        "python3 tests/test_lint_baseline.py"
      ]
    }
  ]
}
