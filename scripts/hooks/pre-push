#!/bin/sh
# 进仓的惰性钩子：推之前跑 check 全链路，红就不让推（不绿推不出去）。
# 惰性：这台机器没铺体系（check.sh 不在）→ 直接放行。
# 启用：git config core.hooksPath scripts/hooks     关闭：git config --unset core.hooksPath
#
# git 会从 stdin 传入「<本地 ref> <本地 sha> <远端 ref> <远端 sha>」。
# 把第一个已存在的远端 sha 作为 LINT_BASE 交给 lint 基线 —— 「本次变更」= 这次真正要推上去的东西。
#
# ⚠️ 禁 `git push --no-verify`（紧急须知会团队）。

[ -f tests/check.sh ] || exit 0

ZERO=0000000000000000000000000000000000000000
while read -r _lref _lsha _rref rsha; do
	if [ -n "${rsha:-}" ] && [ "$rsha" != "$ZERO" ] && [ -z "${LINT_BASE:-}" ]; then
		LINT_BASE="$rsha"
	fi
done
[ -n "${LINT_BASE:-}" ] && export LINT_BASE

echo "[pre-push] 跑 check 全链路（钉桩 → lint 基线 → API → 模块）…"
if ! bash tests/check.sh </dev/null; then
	cat <<'EOF'

⛔ check 未通过 → 拒推（不绿推不出去）。
自救：
  1. 看上面哪一段红，先修到全绿；改判据文件被锁 → bash scripts/unlock-tests.sh（改完锁回）
  2. lint 基线红 = 本次改动新增了样式告警 → 修掉（不是刷基线）
  3. 交活前完整验收（含 E2E 三步）：bash tests/run_all.sh
  4. 不要用 `git push --no-verify` 绕
EOF
	exit 1
fi
echo "[pre-push] check 全绿，放行。"
