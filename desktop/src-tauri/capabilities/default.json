{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Agent Depot 主窗口 + 本地控制台（127.0.0.1:8317）IPC",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8317",
      "http://127.0.0.1:8317/*",
      "http://localhost:8317/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-desktop-get-settings",
    "allow-desktop-set-settings",
    "allow-desktop-profile",
    "allow-desktop-runtime-info"
  ]
}
